STYLE_SETTINGS_BODY_CLASSES=theme-dark mod-linux is-frameless is-hidden-frameless obsidian-app styled-scrollbars show-inline-title is-floating-nav auto-full-screen show-ribbon show-view-header code-styler code-styler-style-inline code-styler-gutter-highlight css-settings-manager AT-row oz-show-all-num is-maximized

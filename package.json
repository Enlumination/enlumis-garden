{
  "name": "web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prebuild": "rimraf dist",
    "build:sass": "sass src/site/styles:dist/styles --style compressed",
    "build:eleventy": "cross-env ELEVENTY_ENV=prod UV_THREADPOOL_SIZE=4 NODE_OPTIONS=--max-old-space-size=4096 eleventy",
    "build": "npm-run-all get-theme build:sass build:eleventy",
    "start": "npm-run-all get-theme --parallel watch:*",
    "watch:eleventy": "cross-env ELEVENTY_ENV=dev eleventy --serve",
    "watch:sass": "sass src/site/styles:dist/styles --watch",
    "get-theme": "node src/site/get-theme.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "cross-env": "^7.0.3",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.0.1",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-mathjax3": "^4.3.2",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.5",
    "sass": "^1.77.6",
    "slugify": "^1.6.6"
  },
  "author": "",
  "license": "ISC"
